# OpenShipTracker Configuration
# Copy this file to .env and adjust variables as needed

PORT=8050
HOST=0.0.0.0

# AISStream API Key (free key available at https://aisstream.io)
# Used for real-time AIS live feed over WebSockets
AISSTREAM_API_KEY=

# VesselFinder API Key (optional fallback at https://www.vesselfinder.com/api)
VESSELFINDER_API_KEY=

# Directory for storing vessels.json, configuration and SQLite history archive
DATA_DIR=./data
